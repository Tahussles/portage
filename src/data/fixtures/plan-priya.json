    {
      "id": "direct_from_source",
      "severity": "info",
      "title": {
        "en": "These documents must come from the source",
        "fr": "Ces documents doivent provenir de la source"
      },
      "body": {
        "en": "These must be sent to CNO by your employer or regulator, not uploaded by you.",
        "fr": "Ils doivent être envoyés à l'OIIO par votre employeur ou votre ordre professionnel, et non téléversés par vous."
      },
      "relatedNodes": [
